# Byte-compiled files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual environment
venv/
.venv/

# Environment variables
.env
env/

# IDE configs
.vscode/
.idea/

# Ignore Excel lock files
~$*.xlsx

# Ignore all visual outputs
data/outputs/irr_scores.json
data/outputs/irr_scores.xlsx
data/outputs/model_disagreements.xlsx
data/outputs/concept_frequency_consensus.xlsx
data/outputs/visualizations/

# Ignore raw and intermediate data
data/raw/
data/validated/

# Ignore generated JSON ratings
data/outputs/classification_ratings.json

models/bertopic_model

# Batch pipeline cache & inputs
data/batch/cached_results/
data/batch/inputs/
data/batch/openai_batch_input.jsonl
data/batch/anthropic_batch_input.json

# Generated outputs
data/outputs/*.xlsx
data/outputs/*.jsonl

# Logs
logs/*.txt

# Analysis scratch dirs
data_analysis/
reliability_out/

# -------------------------
# reliability (contains code + results)
#   Keep .py; ignore generated artifacts
# -------------------------
reliability/__pycache__/
reliability/*.xlsx
reliability/*.csv
reliability/*.json
reliability/*.html
reliability/*.png
reliability/*.jpg
reliability/*.svg
reliability/~$*
!reliability/*.py
!reliability/README*

outputs/**

